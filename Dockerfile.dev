# meili-ingest — development image (used by compose.yaml with `docker compose watch`).
#
# cargo-watch recompiles and restarts the selected binary whenever Compose
# syncs a changed file into /app/crates. The compose service overrides CMD to
# pick the binary (`--bin meili-ingest-control-plane`, `--bin meili-ingest-worker`).
#
# Cargo caches (registry, git, target) are mounted as named volumes by
# compose.yaml so rebuilds are incremental.
#
# There is deliberately no `cargo build` in this image. compose.yaml mounts the
# shared `target-cache` volume over /app/target, and Docker only seeds a named
# volume from the image while it is still empty. So a pre-build helped at most on
# the very first run on a fresh machine, where it merely moved the same compile
# from build time to run time. After that it was pure cost: ~12 GB of debug
# artefacts baked into every service's image and re-written on every source change,
# all hidden by the volume. Now the first `cargo watch` compiles into the volume
# once and every service reuses it.

FROM rust:1.94-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config libssl-dev curl \
 && rm -rf /var/lib/apt/lists/* \
 && cargo install cargo-watch --locked

WORKDIR /app
COPY . .

EXPOSE 8080 9000
ENV RUST_LOG=info,meili_ingest=debug \
    CARGO_TERM_COLOR=always

CMD ["cargo", "watch", "-x", "run --bin meili-ingest-gateway", "-w", "crates"]
